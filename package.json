{
  "name": "thearchy-monorepo",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "神治（Thearchy）— local multi-agent quality governance for coding agents.",
  "homepage": "https://github.com/hqfzs/thearchy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hqfzs/thearchy.git"
  },
  "bugs": {
    "url": "https://github.com/hqfzs/thearchy/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -b && node scripts/copy-assets.mjs && node scripts/bundle-cli.mjs",
    "test": "npm run build && npm run validate:evals && node --test tests/core.test.mjs tests/adapters.test.mjs tests/cli.test.mjs tests/git.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "validate:templates": "npm run build && node packages/cli/dist/index.js template validate templates",
    "validate:evals": "node scripts/validate-evals.mjs",
    "validate:plugin": "npm run build && node scripts/validate-generated-plugin.mjs",
    "test:stability": "npm run build && node scripts/stability-smoke.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "pack:check": "npm pack --workspace packages/cli --dry-run",
    "sbom": "npm sbom --sbom-format spdx > thearchy.spdx.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.9",
    "typescript": "^7.0.2"
  }
}
